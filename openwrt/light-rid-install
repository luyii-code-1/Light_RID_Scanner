#!/bin/sh

APP_ROOT=/usr/share/light-rid
CONFIG_DIR=/etc/light-rid
CONFIG="$CONFIG_DIR/config.json"
DEFAULT_CONFIG="$APP_ROOT/config.gl-ar750s.json"
MODEL_MAP="$CONFIG_DIR/rid_model.json"
DEFAULT_MODEL_MAP="$APP_ROOT/rid_model.json"
PROG=/usr/bin/python3
ORIGINAL_NETWORK="$CONFIG_DIR/openwrt-original"

fail() {
    echo "light-rid-install: $*" >&2
    exit 1
}

backup_original_network() {
    if [ -s "$ORIGINAL_NETWORK/manifest.sha256" ]; then
        echo "light-rid-install: original OpenWrt network backup preserved"
        return
    fi
    temporary="$CONFIG_DIR/openwrt-original.new.$$"
    rm -rf "$temporary"
    mkdir -m 0700 "$temporary" || fail "cannot create original network backup"
    for name in network wireless dhcp firewall uhttpd; do
        [ -s "/etc/config/$name" ] || fail "OpenWrt configuration is missing: $name"
        cp -p "/etc/config/$name" "$temporary/$name" || fail "cannot back up OpenWrt $name configuration"
        chmod 0600 "$temporary/$name"
    done
    (cd "$temporary" && sha256sum network wireless dhcp firewall uhttpd > manifest.sha256) || \
        fail "cannot checksum original network backup"
    chmod 0600 "$temporary/manifest.sha256"
    mv "$temporary" "$ORIGINAL_NETWORK" || fail "cannot install original network backup"
    echo "light-rid-install: original OpenWrt network configuration backed up"
}

factory_provision_wifi() {
    ssid="${LIGHT_RID_FACTORY_SSID:-}"
    wifi_password="${LIGHT_RID_FACTORY_WIFI_PASSWORD:-}"
    if [ -z "$ssid" ] || [ -z "$wifi_password" ]; then
        [ -t 0 ] || fail "factory provisioning requires LIGHT_RID_FACTORY_SSID and LIGHT_RID_FACTORY_WIFI_PASSWORD when stdin is not interactive"
        printf 'Factory 5GHz SSID: '
        IFS= read -r ssid
        printf 'Factory 5GHz password: '
        stty -echo
        IFS= read -r wifi_password
        stty echo
        printf '\n'
    fi
    ssid_bytes="$(printf '%s' "$ssid" | wc -c | tr -d ' ')"
    password_bytes="$(printf '%s' "$wifi_password" | wc -c | tr -d ' ')"
    [ "$ssid_bytes" -ge 1 ] && [ "$ssid_bytes" -le 32 ] || fail "factory SSID must be 1-32 bytes"
    [ "$password_bytes" -ge 8 ] && [ "$password_bytes" -le 63 ] || fail "factory WiFi password must be 8-63 bytes"
    command -v uci >/dev/null 2>&1 || fail "uci is required for factory WiFi provisioning"
    uci set wireless.default_radio0.device='radio0' || fail "cannot select 5GHz radio"
    uci set wireless.default_radio0.network='lan' || fail "cannot bind factory AP to LAN"
    uci set wireless.default_radio0.mode='ap' || fail "cannot set factory AP mode"
    uci set wireless.default_radio0.encryption='psk2' || fail "cannot set factory AP encryption"
    uci set "wireless.default_radio0.ssid=$ssid" || fail "cannot set factory SSID"
    uci set "wireless.default_radio0.key=$wifi_password" || fail "cannot set factory WiFi password"
    uci set wireless.default_radio0.disabled='0' || fail "cannot enable factory AP"
    uci commit wireless || fail "cannot commit factory WiFi configuration"
    wifi reload radio0 >/dev/null 2>&1 || fail "cannot reload factory 5GHz AP"
    unset wifi_password LIGHT_RID_FACTORY_WIFI_PASSWORD
    echo "light-rid-install: shared factory 5GHz credentials provisioned (password not printed)"
}

provision_auth() {
    "$PROG" - "$CONFIG" <<'PY'
import base64
import hashlib
import json
import os
import secrets
import sys
import tempfile

path = sys.argv[1]
with open(path, "r", encoding="utf-8") as handle:
    config = json.load(handle)

def secret_hash(value):
    salt = base64.urlsafe_b64encode(os.urandom(16)).rstrip(b"=").decode("ascii")
    digest = hashlib.scrypt(value.encode("utf-8"), salt=salt.encode("ascii"), n=2 ** 14, r=8, p=1, dklen=32)
    encoded = base64.urlsafe_b64encode(digest).rstrip(b"=").decode("ascii")
    return "scrypt$16384$8$1${}${}".format(salt, encoded)

username = "admin"
password = secrets.token_urlsafe(12)
auth = config.setdefault("auth", {})
auth.update({
    "enabled": True,
    "username_hash": secret_hash(username),
    "password_hash": secret_hash(password),
    "realm": "Light RID Scanner",
    "login_methods": ["password"],
    "sso_links": [],
    "passkeys": [],
})

parent = os.path.dirname(path)
fd, temporary = tempfile.mkstemp(prefix="config.", suffix=".tmp", dir=parent)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        json.dump(config, handle, ensure_ascii=False, indent=2)
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.chmod(temporary, 0o600)
    os.replace(temporary, path)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)

print("light-rid-install: admin_username={}".format(username))
print("light-rid-install: admin_password={}".format(password))
print("light-rid-install: record this one-time password now; only its scrypt hash was stored")
PY
}

case "${1:-}" in
    ""|--factory-reset|--factory-provision) ;;
    *) fail "Usage: light-rid-install [--factory-reset|--factory-provision]" ;;
esac

board="$(cat /tmp/sysinfo/board_name 2>/dev/null)"
[ "$board" = "glinet,gl-ar750s-nor-nand" ] || \
    fail "unsupported board '${board:-unknown}'"
grep -q "DISTRIB_ARCH='mips_24kc'" /etc/openwrt_release 2>/dev/null || \
    fail "OpenWrt mips_24kc userspace is required"
[ -s "$DEFAULT_CONFIG" ] || fail "default configuration is missing"
[ -s "$DEFAULT_MODEL_MAP" ] || fail "default model map is missing"
command -v "$PROG" >/dev/null 2>&1 || fail "python3 is required"
[ ! -x /etc/init.d/light-rid ] || /etc/init.d/light-rid stop >/dev/null 2>&1 || true
stop_wait=0
while ps w | grep -q '[s]tation_edition/run.py'; do
    stop_wait=$((stop_wait + 1))
    [ "$stop_wait" -ge 15 ] && break
    sleep 1
done
running="$(ps w | awk '/[s]tation_edition\/run.py/{print $1}' | tr '\n' ' ')"
[ -z "$running" ] || fail "scanner is running (pid $running); stop it before install"

umask 077
mkdir -p "$CONFIG_DIR" /tmp/light-rid || fail "cannot create runtime directories"
backup_original_network

if [ "${1:-}" = "--factory-reset" ]; then
    if [ -f "$CONFIG" ]; then
        backup="$CONFIG.factory-$(date '+%Y%m%d-%H%M%S').bak"
        cp -p "$CONFIG" "$backup" || fail "cannot back up existing configuration"
        echo "light-rid-install: configuration backup: $backup"
    fi
    cp "$DEFAULT_CONFIG" "$CONFIG" || fail "cannot reset configuration"
    provision_auth || fail "cannot provision unique administrator credentials"
    echo "light-rid-install: factory configuration installed"
elif [ -e "$CONFIG" ]; then
    echo "light-rid-install: existing configuration preserved"
else
    cp "$DEFAULT_CONFIG" "$CONFIG" || fail "cannot install initial configuration"
    provision_auth || fail "cannot provision unique administrator credentials"
    echo "light-rid-install: initial configuration installed"
fi

chmod 0700 "$CONFIG_DIR"
chmod 0600 "$CONFIG"
if [ ! -e "$MODEL_MAP" ]; then
    cp "$DEFAULT_MODEL_MAP" "$MODEL_MAP" || fail "cannot install initial model map"
    echo "light-rid-install: initial model map installed"
fi
chmod 0600 "$MODEL_MAP"
chmod 0755 /usr/bin/light-rid-run /usr/bin/light-rid-install /usr/bin/light-rid-upgrade /usr/bin/light-rid-capture /etc/init.d/light-rid

if [ "${1:-}" = "--factory-provision" ]; then
    factory_provision_wifi
fi

/usr/bin/light-rid-run reserve || fail "cannot reserve radio1 for RID capture"

# Remove host-Python bytecode and build-only files left by older tarballs.
rm -rf "$APP_ROOT/station_edition/__pycache__"
rm -rf "$APP_ROOT/station_edition/light_rid/__pycache__"
rm -rf "$APP_ROOT/station_edition/pytools"
rm -f "$APP_ROOT/station_edition/config.example.json"

/usr/bin/light-rid-run check || fail "production preflight failed"
/etc/init.d/light-rid enable || fail "cannot enable Light RID autostart"
/etc/init.d/light-rid restart || fail "cannot start Light RID service"
sync
echo "light-rid-install: ready; Light RID is enabled and running"
