#!/bin/sh

PROG=/usr/bin/python3
APP_ROOT=/usr/share/light-rid
APP="$APP_ROOT/station_edition/run.py"
CAPTURE=/usr/bin/light-rid-capture
CONFIG=/etc/light-rid/config.json
MANIFEST="$APP_ROOT/package-manifest.sha256"
LOCK_DIR=/tmp/light-rid.lock
CHILD_PID=""
LOCK_HELD=0
MONITOR_PREPARED=0

fail() {
    echo "light-rid: $*" >&2
    exit 1
}

board_name() {
    cat /tmp/sysinfo/board_name 2>/dev/null
}

check_board() {
    board="$(board_name)"
    [ "$board" = "glinet,gl-ar750s-nor-nand" ] || \
        fail "unsupported board '${board:-unknown}' (expected GL-AR750S NOR/NAND)"
    grep -q "DISTRIB_ARCH='mips_24kc'" /etc/openwrt_release 2>/dev/null || \
        fail "OpenWrt mips_24kc userspace is required"
}

check_runtime() {
    check_board
    for command in "$PROG" iw ip wifi awk sha256sum; do
        command -v "$command" >/dev/null 2>&1 || fail "required command is missing: $command"
    done
    [ -x "$CAPTURE" ] || fail "capture helper is missing"
    [ -f "$APP" ] || fail "station application is missing"
    [ -s "$CONFIG" ] || fail "configuration is missing; run light-rid-install first"
    [ -s "$APP_ROOT/station_edition/light_rid/assets/templates/station-settings.html" ] || \
        fail "settings template is missing"
    [ -s "$APP_ROOT/station_edition/light_rid/assets/vue/station-settings.js" ] || \
        fail "settings JavaScript is missing"
    [ -s "$APP_ROOT/station_edition/light_rid/assets/templates/router.html" ] || \
        fail "router template is missing"
    [ -s "$APP_ROOT/station_edition/light_rid/assets/vue/router.js" ] || \
        fail "router JavaScript is missing"
    "$PROG" -c 'import json, sqlite3, urllib.request' >/dev/null 2>&1 || \
        fail "Python json/sqlite3/urllib modules are incomplete"
    "$CAPTURE" --help >/dev/null 2>&1 || fail "capture helper cannot execute on this router"
    mem_kb="$(awk '/^MemTotal:/{print $2}' /proc/meminfo 2>/dev/null)"
    [ "${mem_kb:-0}" -ge 100000 ] || fail "at least 100 MB RAM is required"
    free_kb="$(df -k /overlay 2>/dev/null | awk 'NR==2{print $4}')"
    [ "${free_kb:-0}" -ge 8192 ] || fail "at least 8 MB free overlay storage is required"
    if [ -s "$MANIFEST" ]; then
        (cd / && sha256sum -c "$MANIFEST" >/dev/null 2>&1) || fail "installed files failed checksum verification"
    fi
}

reserve_scan_radio() {
    check_board
    command -v uci >/dev/null 2>&1 || fail "required command is missing: uci"
    changed=0
    for option in wireless.radio1.disabled wireless.default_radio1.disabled wireless.guest2g.disabled; do
        current="$(uci -q get "$option" 2>/dev/null)"
        if [ "$current" != "1" ]; then
            uci set "$option=1" || fail "cannot reserve radio1: $option"
            changed=1
        fi
    done
    if [ "$changed" -eq 1 ]; then
        uci commit wireless || fail "cannot commit radio1 reservation"
    fi
    wifi down radio1 >/dev/null 2>&1 || true
    for iface in $(iw dev 2>/dev/null | awk '
        /^phy#1$/ { in_phy=1; next }
        /^phy#/ { in_phy=0 }
        in_phy && $1=="Interface" && $2!="ridmon" { print $2 }
    '); do
        iw dev "$iface" del >/dev/null 2>&1 || true
    done
}

acquire_lock() {
    if mkdir "$LOCK_DIR" 2>/dev/null; then
        LOCK_HELD=1
    else
        owner="$(cat "$LOCK_DIR/launcher.pid" 2>/dev/null)"
        if [ -n "$owner" ] && kill -0 "$owner" 2>/dev/null; then
            fail "already running (launcher pid $owner)"
        fi
        rm -rf "$LOCK_DIR"
        mkdir "$LOCK_DIR" 2>/dev/null || fail "cannot acquire runtime lock"
        LOCK_HELD=1
    fi
    echo "$$" > "$LOCK_DIR/launcher.pid"
    existing="$(station_pids)"
    if [ -n "$existing" ]; then
        rm -rf "$LOCK_DIR"
        LOCK_HELD=0
        fail "station process already exists outside this launcher (pid $existing); run light-rid-run stop"
    fi
}

station_pids() {
    ps w | awk '/[s]tation_edition\/run.py/{print $1}' | tr '\n' ' ' | sed 's/[[:space:]]*$//'
}

cleanup() {
    trap - EXIT HUP INT TERM
    if [ -n "$CHILD_PID" ]; then
        kill "$CHILD_PID" >/dev/null 2>&1
        wait "$CHILD_PID" >/dev/null 2>&1
    fi
    if [ "$MONITOR_PREPARED" -eq 1 ]; then
        iw dev ridmon del >/dev/null 2>&1
    fi
    if [ "$LOCK_HELD" -eq 1 ]; then
        rm -rf "$LOCK_DIR"
    fi
}

prepare_monitor() {
    reserve_scan_radio
    retries=0
    while ! iw phy phy1 info >/dev/null 2>&1; do
        retries=$((retries + 1))
        [ "$retries" -ge 12 ] && return 1
        sleep 1
    done
    wifi down radio1 >/dev/null 2>&1
    # From this point onward cleanup must remove a partial monitor interface;
    # radio1 stays reserved for RID even when startup fails halfway through.
    MONITOR_PREPARED=1
    retries=0
    stable=0
    while [ "$stable" -lt 2 ]; do
        conflicts="$(iw dev 2>/dev/null | awk '
            /^phy#1$/ { in_phy=1; next }
            /^phy#/ { in_phy=0 }
            in_phy && $1=="Interface" && $2!="ridmon" { print $2 }
        ')"
        if [ -n "$conflicts" ]; then
            for iface in $conflicts; do
                iw dev "$iface" del >/dev/null 2>&1 || true
            done
            stable=0
        else
            stable=$((stable + 1))
        fi
        retries=$((retries + 1))
        [ "$retries" -ge 15 ] && return 1
        sleep 1
    done
    iw dev ridmon del >/dev/null 2>&1
    iw phy phy1 interface add ridmon type monitor || return 1
    ip link set ridmon up || return 1
    iw dev ridmon set channel 6 HT20 || return 1
}

monitor_healthy() {
    iw dev ridmon info 2>/dev/null | grep -q 'type monitor' || return 1
    iw dev ridmon info 2>/dev/null | grep -q 'channel 6 ' || return 1
    ip link show dev ridmon 2>/dev/null | grep -q 'UP' || return 1
    conflicts="$(iw dev 2>/dev/null | awk '
        /^phy#1$/ { in_phy=1; next }
        /^phy#/ { in_phy=0 }
        in_phy && $1=="Interface" && $2!="ridmon" { print $2 }
    ')"
    [ -z "$conflicts" ]
}

show_status() {
    build="$(sed -n 's/.*"commit":"\([^"]*\)".*/\1/p' "$APP_ROOT/rid_build_info.json" 2>/dev/null)"
    launcher="$(cat "$LOCK_DIR/launcher.pid" 2>/dev/null)"
    app_pid="$(cat "$LOCK_DIR/app.pid" 2>/dev/null)"
    all_station_pids="$(station_pids)"
    device_id="$(cat /sys/class/net/eth0/address 2>/dev/null | tr -d ':')"
    available_kb="$(awk '/^MemAvailable:/{print $2}' /proc/meminfo 2>/dev/null)"
    overlay_kb="$(df -k /overlay 2>/dev/null | awk 'NR==2{print $4}')"
    echo "board=$(board_name)"
    echo "device_id=${device_id:-unknown}"
    echo "build=${build:-unknown}"
    echo "memory_available_kb=${available_kb:-unknown}"
    echo "overlay_free_kb=${overlay_kb:-unknown}"
    if [ -n "$launcher" ] && kill -0 "$launcher" 2>/dev/null; then
        echo "launcher=running pid=$launcher"
    else
        echo "launcher=stopped"
    fi
    if [ -n "$app_pid" ] && kill -0 "$app_pid" 2>/dev/null; then
        echo "station=running pid=$app_pid"
    else
        echo "station=stopped"
    fi
    echo "station_pids=${all_station_pids:-none}"
    if iw dev ridmon info >/dev/null 2>&1; then
        echo "monitor=ridmon channel=$(iw dev ridmon info | awk '/channel/{print $2; exit}')"
    else
        echo "monitor=stopped"
    fi
    if iw dev wlan0 info >/dev/null 2>&1; then
        ap_channel="$(iw dev wlan0 info | awk '/channel/{print $2; exit}')"
        echo "management_ap=wlan0 channel=${ap_channel:-unknown}"
    else
        echo "management_ap=unavailable"
    fi
    if netstat -ln 2>/dev/null | grep -q ':4600[[:space:]]'; then
        echo "web=listen port=4600"
    else
        echo "web=stopped port=4600"
    fi
    if [ -x /etc/init.d/light-rid ] && /etc/init.d/light-rid enabled >/dev/null 2>&1; then
        echo "autostart=enabled"
    else
        echo "autostart=disabled"
    fi
}

stop_runtime() {
    if [ -x /etc/init.d/light-rid ] && [ "${LIGHT_RID_PROCD_STOP:-0}" != "1" ]; then
        LIGHT_RID_PROCD_STOP=1 /etc/init.d/light-rid stop >/dev/null 2>&1 || true
    fi
    launcher="$(cat "$LOCK_DIR/launcher.pid" 2>/dev/null)"
    if [ -n "$launcher" ] && kill -0 "$launcher" 2>/dev/null; then
        kill "$launcher" >/dev/null 2>&1
        retries=0
        while kill -0 "$launcher" 2>/dev/null; do
            retries=$((retries + 1))
            [ "$retries" -ge 10 ] && break
            sleep 1
        done
    fi
    for pid in $(station_pids); do
        kill "$pid" >/dev/null 2>&1
    done
    retries=0
    while [ -n "$(station_pids)" ]; do
        retries=$((retries + 1))
        [ "$retries" -ge 5 ] && break
        sleep 1
    done
    for pid in $(station_pids); do
        kill -9 "$pid" >/dev/null 2>&1
    done
    rm -rf "$LOCK_DIR"
    iw dev ridmon del >/dev/null 2>&1
    reserve_scan_radio >/dev/null 2>&1 || true
    echo "light-rid: stopped"
}

case "${1:-run}" in
    check)
        check_runtime
        echo "light-rid: preflight passed"
        exit 0
        ;;
    status)
        show_status
        exit 0
        ;;
    stop)
        stop_runtime
        exit 0
        ;;
    reserve)
        reserve_scan_radio
        echo "light-rid: radio1 reserved for RID capture"
        exit 0
        ;;
    supervise)
        ;;
    run)
        ;;
    *)
        echo "Usage: light-rid-run [run|supervise|check|status|stop|reserve]" >&2
        exit 2
        ;;
esac

umask 077
check_runtime
acquire_lock
trap cleanup EXIT HUP INT TERM
prepare_monitor || fail "failed to prepare phy1/ridmon"

mkdir -p /tmp/light-rid
cd "$APP_ROOT" || fail "cannot enter $APP_ROOT"
echo "light-rid: starting GL-AR750S scanner; press Ctrl+C to stop"
PYTHONPATH="$APP_ROOT" \
LIGHT_RID_APP_ROOT="$APP_ROOT" \
LIGHT_RID_CAPTURE_HELPER="$CAPTURE" \
PYTHONDONTWRITEBYTECODE=1 \
PYTHONUNBUFFERED=1 \
TMPDIR=/tmp/light-rid \
"$PROG" "$APP" --config "$CONFIG" --iface ridmon --channel 6 --no-tui &
CHILD_PID=$!
echo "$CHILD_PID" > "$LOCK_DIR/app.pid"
while kill -0 "$CHILD_PID" >/dev/null 2>&1; do
    sleep 5
    if ! monitor_healthy; then
        echo "light-rid: radio1 ownership lost; restarting supervised runtime" >&2
        kill "$CHILD_PID" >/dev/null 2>&1 || true
        wait "$CHILD_PID" >/dev/null 2>&1 || true
        CHILD_PID=""
        exit 75
    fi
done
wait "$CHILD_PID"
STATUS=$?
CHILD_PID=""
exit "$STATUS"
