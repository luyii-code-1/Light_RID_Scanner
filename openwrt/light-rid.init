#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/python3
APP=/usr/share/light-rid/station_edition/run.py
CAPTURE=/usr/bin/light-rid-capture
CONFIG=/etc/light-rid/config.json

prepare_monitor() {
    wifi down radio1 >/dev/null 2>&1
    iw dev ridmon del >/dev/null 2>&1
    iw phy phy1 interface add ridmon type monitor || return 1
    ip link set ridmon up || return 1
    iw dev ridmon set channel 6 HT20 || return 1
}

start_service() {
    [ -x "$PROG" ] || { logger -t light-rid "python3 is not installed"; return 1; }
    [ -x "$CAPTURE" ] || { logger -t light-rid "capture helper is missing"; return 1; }
    prepare_monitor || { logger -t light-rid "failed to prepare ridmon"; return 1; }

    procd_open_instance
    procd_set_param command "$PROG" "$APP" --config "$CONFIG" --iface ridmon --channel 6 --no-tui
    procd_set_param env PYTHONPATH=/usr/share/light-rid LIGHT_RID_CAPTURE_HELPER="$CAPTURE"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    iw dev ridmon del >/dev/null 2>&1
    wifi up radio1 >/dev/null 2>&1
}
